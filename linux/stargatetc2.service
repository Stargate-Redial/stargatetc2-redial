# Example systemd unit: /etc/systemd/system/stargatetc2.service, then
#   systemctl daemon-reload && systemctl enable --now stargatetc2
# The console stays reachable with: sudo -u steam screen -r SGTC2   (Ctrl+A, D to leave it)
# Restart=always restarts the screen if it dies; run-server.sh restarts srcds after a crash.
[Unit]
Description=StargateTC 2 dedicated server (Stargate Redial)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=steam
Environment=SRCDS_DIR=/home/steam/sgtc2-server/srcds2006 PORT=27015 MAXPLAYERS=16 MAP=sg2_temple
ExecStart=/usr/bin/screen -DmS SGTC2 /home/steam/sgtc2-server/run-server.sh
Restart=always
RestartSec=10
# 10 bots fit in about 150 MB; more is a leak.
MemoryMax=1G
LimitCORE=infinity

[Install]
WantedBy=multi-user.target
